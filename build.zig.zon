.{
    .name = .ziggy_example_vite,
    .version = "1.0.0",
    .fingerprint = 0xc31d2a38c0ad0c9a,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Ziggy, from the checkout of its repository beside this one. Every other place that takes Ziggy (package.json, the Xcode
        // projects and native/android/settings.gradle) takes the same checkout.
        .ziggy = .{
            .path = "../ziggy",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "backend",
        "native",
    },
}
