// The app's details, which Ziggy's build reads: its name, which names its log files, its title, which heads them, and its version,
// which they give.
.{
    .name = "ziggy-example-vite",
    .title = "Ziggy Vite example",
    .version = "1.0.0",
    .splash = .{
        .background = "#FFFFFF",
        .portrait = "assets/splash-portrait.png",
        .landscape = "assets/splash-landscape.png",
    },
}
